#!/bin/bash
# ============================================================
# ZVOL Manager — 升级后配置回调
# 在文件解压覆盖后执行。
# 必须安装到 venv（与 install_callback / main 保持一致），
# 否则依赖进了系统 Python，uvicorn 仍跑旧依赖，行为不一致。
# ============================================================

PACKAGE_BASE="${TRIM_APPDEST}"
VENV_PYTHON="${PACKAGE_BASE}/.venv/bin/python3"
VENV_PIP="${PACKAGE_BASE}/.venv/bin/pip"

if [ ! -x "${VENV_PYTHON}" ]; then
    echo "[upgrade_callback] venv 不存在 (${VENV_PYTHON})，请重新安装应用" >> "${TRIM_PKGVAR}/zvol-manager.log" 2>/dev/null || true
    exit 1
fi

if [ -f "${PACKAGE_BASE}/requirements.txt" ]; then
    "${VENV_PYTHON}" -m pip install --upgrade pip 2>> "${TRIM_PKGVAR}/zvol-manager.log" 2>/dev/null || true
    "${VENV_PIP}" install -r "${PACKAGE_BASE}/requirements.txt" 2>> "${TRIM_PKGVAR}/zvol-manager.log" 2>/dev/null || \
    "${VENV_PYTHON}" -m pip install -r "${PACKAGE_BASE}/requirements.txt" 2>> "${TRIM_PKGVAR}/zvol-manager.log" 2>/dev/null || true
fi

exit 0
