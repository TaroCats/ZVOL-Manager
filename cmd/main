#!/bin/bash
# ============================================================
# ZVOL Manager — 应用生命周期管理脚本
# 
# 命令: start | stop | status (exit 0=运行, 3=未运行)
# 
# 运行时环境:
#   - Python: 飞牛 python312 (/var/apps/python312/target/bin)
#   - 虚拟环境: ${TRIM_APPDEST}/.venv（install_callback 创建）
#   - 后端代码: ${TRIM_APPDEST}/backend.py
# ============================================================

APP_BASE="${TRIM_APPDEST}"
VENV_PYTHON="${APP_BASE}/.venv/bin/python3"
PORT="${WEB_PORT:-8765}"
HOST="0.0.0.0"

mkdir -p "${TRIM_PKGVAR}" 2>/dev/null || true

PID_FILE="${TRIM_PKGVAR}/zvol-manager.pid"
LOG_FILE="${TRIM_PKGVAR}/zvol-manager.log"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "${LOG_FILE}"
}

# -------------------------------------------------------
# 清理端口上残留的 uvicorn 进程（自动停用时 stop 可能未被调用）
# -------------------------------------------------------
clean_port() {
    local port_pid
    port_pid=$(fuser "${PORT}/tcp" 2>/dev/null || true)
    if [ -z "${port_pid}" ]; then
        return 0
    fi

    log "端口 ${PORT} 被进程 ${port_pid} 占用，检查..."
    if ps -p "${port_pid}" -o cmd= 2>/dev/null | grep -q "uvicorn backend:app"; then
        log "检测到旧的 uvicorn 残留进程 (PID: ${port_pid})，正在终止..."
        kill -TERM "${port_pid}" 2>/dev/null || true
        sleep 0.5
        kill -9 "${port_pid}" 2>/dev/null || true

        local waited=0
        while fuser "${PORT}/tcp" 2>/dev/null && [ ${waited} -lt 10 ]; do
            sleep 0.3
            waited=$((waited + 1))
        done

        if fuser "${PORT}/tcp" 2>/dev/null; then
            log "错误：无法释放端口 ${PORT}"
            return 1
        fi
        log "旧进程已终止，端口 ${PORT} 已释放"
        return 0
    fi

    log "错误：端口 ${PORT} 被其他进程占用 (PID: ${port_pid})"
    ps -p "${port_pid}" -o pid,cmd= 2>/dev/null >> "${LOG_FILE}"
    return 1
}

start() {
    log "--- 开始启动 ZVOL Manager ---"

    # 1. 清理僵尸 PID
    if [ -f "${PID_FILE}" ]; then
        local old_pid=$(cat "${PID_FILE}" 2>/dev/null)
        if [ -n "${old_pid}" ] && kill -0 "${old_pid}" 2>/dev/null; then
            log "应用已在运行 (PID: ${old_pid})"
            echo "ZVOL Manager 已在运行 (PID: ${old_pid})"
            exit 0
        fi
        rm -f "${PID_FILE}"
    fi

    # 2. 清理端口残留（关键：自动停用后旧 uvicorn 变僵尸）
    if ! clean_port; then
        echo "错误：端口 ${PORT} 被占用且无法释放" >&2
        exit 1
    fi

    # 3. 检查虚拟环境
    if [ ! -f "${VENV_PYTHON}" ]; then
        log "错误：虚拟环境不存在: ${VENV_PYTHON}"
        echo "错误：Python 虚拟环境未找到，请重新安装应用" >&2
        exit 1
    fi
    log "虚拟环境 Python: ${VENV_PYTHON}"

    # 4. 检查后端代码
    if [ ! -f "${APP_BASE}/backend.py" ]; then
        log "错误：后端代码不存在: ${APP_BASE}/backend.py"
        echo "错误：后端代码文件缺失" >&2
        exit 1
    fi

    # 5. 验证关键模块可导入
    "${VENV_PYTHON}" -c "import fastapi, uvicorn" 2>> "${LOG_FILE}"
    if [ $? -ne 0 ]; then
        log "错误：关键模块 fastapi/uvicorn 导入失败"
        echo "错误：Python 依赖不完整，请重新安装应用" >&2
        exit 1
    fi
    log "关键模块验证通过"

    # 6. 启动后端服务
    cd "${APP_BASE}"
    log "启动 uvicorn (${HOST}:${PORT})..."
    nohup "${VENV_PYTHON}" -m uvicorn backend:app \
        --host "${HOST}" \
        --port "${PORT}" \
        --log-level info \
        --timeout-keep-alive 30 \
        >> "${LOG_FILE}" 2>&1 &

    local svr_pid=$!
    echo "${svr_pid}" > "${PID_FILE}"
    log "进程已启动 (PID: ${svr_pid})"

    # 7. 等待端口就绪
    for i in $(seq 1 30); do
        if ! kill -0 "${svr_pid}" 2>/dev/null; then
            log "错误：进程启动后意外退出（第 ${i} 轮）"
            rm -f "${PID_FILE}"
            tail -20 "${LOG_FILE}" >&2
            echo "错误：ZVOL Manager 进程意外退出" >&2
            exit 1
        fi

        if "${VENV_PYTHON}" -c "
import socket
try:
    s = socket.create_connection(('${HOST}', ${PORT}), timeout=0.5)
    s.close()
    exit(0)
except Exception:
    exit(1)
" 2>/dev/null; then
            log "端口 ${PORT} 就绪，启动成功（约 $((i/2)) 秒）"
            echo "ZVOL Manager 启动成功，监听 ${HOST}:${PORT}"
            exit 0
        fi
        sleep 0.5
    done

    log "错误：启动超时（15 秒）"
    kill "${svr_pid}" 2>/dev/null || true
    rm -f "${PID_FILE}"
    tail -20 "${LOG_FILE}" >&2
    echo "错误：ZVOL Manager 启动超时" >&2
    exit 1
}

stop() {
    # PID 文件清理
    if [ -f "${PID_FILE}" ]; then
        local pid=$(cat "${PID_FILE}" 2>/dev/null)
        if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
            log "停止服务 (PID: ${pid})..."
            kill "${pid}" 2>/dev/null

            local waited=0
            while kill -0 "${pid}" 2>/dev/null && [ ${waited} -lt 30 ]; do
                sleep 0.1
                waited=$((waited + 1))
            done

            if kill -0 "${pid}" 2>/dev/null; then
                kill -9 "${pid}" 2>/dev/null || true
                sleep 0.3
            fi
        fi
        rm -f "${PID_FILE}"
    fi

    # 兜底：通过 fuser 清理端口
    fuser -k "${PORT}/tcp" 2>/dev/null || true
    sleep 0.3

    log "服务已停止"
    echo "ZVOL Manager 已停止"
    exit 0
}

status() {
    if [ ! -f "${PID_FILE}" ]; then
        echo "ZVOL Manager 已停止"
        exit 3
    fi

    local pid=$(cat "${PID_FILE}" 2>/dev/null)
    if [ -z "${pid}" ] || ! kill -0 "${pid}" 2>/dev/null; then
        rm -f "${PID_FILE}" 2>/dev/null
        echo "ZVOL Manager 已停止"
        exit 3
    fi

    if [ -f "${VENV_PYTHON}" ]; then
        if "${VENV_PYTHON}" -c "
import socket
try:
    s = socket.create_connection(('${HOST}', ${PORT}), timeout=2)
    s.close()
    exit(0)
except Exception:
    exit(1)
" 2>/dev/null; then
            echo "ZVOL Manager 运行中 (PID: ${pid}, 端口: ${PORT})"
            exit 0
        fi
        echo "ZVOL Manager PID 存在但端口无响应"
        exit 3
    fi

    echo "ZVOL Manager 运行中 (PID: ${pid})"
    exit 0
}

case "${1}" in
    start)   start ;;
    stop)    stop ;;
    status)  status ;;
    *)
        echo "用法: $0 {start|stop|status}"
        exit 1
        ;;
esac
