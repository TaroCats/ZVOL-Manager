#!/bin/bash
# ============================================================
# ZVOL Manager — 安装前环境检测
# 在文件解压之前执行，阻断不合规环境的安装
# 缺什么写什么，全部只警告不阻断（让用户自行决定）
# ============================================================

LOG="${TRIM_TEMP_LOGFILE}"

WARNINGS=0

note() {
    echo "$*" >> "${LOG}"
    WARNINGS=$((WARNINGS + 1))
}

if ! command -v zfs &>/dev/null; then
    echo "=============================================
  ZVOL Manager 警告：未检测到 zfs 命令
---------------------------------------------
  本应用需要 ZFS 内核模块与 zfs-utils 工具。
  请确认系统已配置 ZFS 存储池。
=============================================" >> "${LOG}"
    WARNINGS=$((WARNINGS + 1))
fi

if ! command -v zpool &>/dev/null; then
    note "警告：未检测到 zpool 命令，ZFS 存储池管理功能不可用"
fi

if ! command -v mkfs.ext4 &>/dev/null; then
    note "警告：未检测到 mkfs.ext4，挂载/格式化功能不可用"
fi

if ! command -v fuser &>/dev/null; then
    note "警告：未检测到 fuser，应用启动/停止时端口清理会受限"
fi

if ! command -v targetcli &>/dev/null; then
    note "警告：未检测到 targetcli，iSCSI 导出功能不可用（ZVOL 管理仍可用）"
    note "  将在 install_callback 阶段自动安装 targetcli-fb"
    note "  或手动: apt install targetcli-fb   /   yum install targetcli"
fi

# 检查 LIO 内核模块（targetcli 依赖）
if [ -f /proc/modules ] && ! grep -q '^target_core_mod' /proc/modules 2>/dev/null; then
    note "提示：target_core_mod 内核模块未加载，install_callback 阶段会尝试 modprobe"
fi

# 检查 fnOS 官方 iSCSI 服务（如有 systemctl 单元）
if command -v systemctl &>/dev/null; then
    for svc in target iscsid iscsi tgt; do
        if systemctl list-unit-files "${svc}.service" 2>/dev/null | grep -q "${svc}.service"; then
            STATE=$(systemctl is-active "${svc}" 2>/dev/null || echo "unknown")
            echo "[install_init] 检测到 systemd 单元 ${svc}.service，当前状态: ${STATE}" >> "${LOG}"
        fi
    done
fi

if [ ${WARNINGS} -gt 0 ]; then
    echo "=============================================
  共发现 ${WARNINGS} 项警告
  ZVOL 管理基础功能依赖 zfs 命令，请务必确认已安装。
=============================================" >> "${LOG}"
fi

exit 0
