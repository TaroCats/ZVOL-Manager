#!/bin/bash
# ============================================================
# ZVOL Manager — 安装后配置回调
# 在文件解压后、app/ 目录平铺到 TRIM_APPDEST 之后执行
# 此时 install_dep_apps 声明的 python312 运行时已就绪
# ============================================================

RUNTIME_PYTHON=/var/apps/python312/target/bin/python3
RUNTIME_PIP=/var/apps/python312/target/bin/pip3
APP_BASE="${TRIM_APPDEST}"

echo "ZVOL Manager v1.3.0 安装配置" > "${TRIM_TEMP_LOGFILE}"
echo "=============================================" >> "${TRIM_TEMP_LOGFILE}"

# 1. 检查 Python 运行时是否就绪
if [ ! -x "${RUNTIME_PYTHON}" ]; then
    echo "错误：Python312 运行时未安装，请检查 manifest 中 install_dep_apps=python312 声明。" >> "${TRIM_TEMP_LOGFILE}"
    exit 1
fi

echo "Python 运行时: $(${RUNTIME_PYTHON} --version)" >> "${TRIM_TEMP_LOGFILE}"

# 2. 创建虚拟环境
echo "创建 Python 虚拟环境..." >> "${TRIM_TEMP_LOGFILE}"
cd "${APP_BASE}" || { echo "错误：无法进入 ${APP_BASE}" >> "${TRIM_TEMP_LOGFILE}"; exit 1; }

export PATH=/var/apps/python312/target/bin:$PATH
python3 -m venv .venv 2>> "${TRIM_TEMP_LOGFILE}"
if [ $? -ne 0 ]; then
    echo "错误：创建虚拟环境失败" >> "${TRIM_TEMP_LOGFILE}"
    exit 1
fi

source .venv/bin/activate

# 3. 安装/升级 pip
echo "升级 pip..." >> "${TRIM_TEMP_LOGFILE}"
pip install --upgrade pip 2>> "${TRIM_TEMP_LOGFILE}"

# 4. 安装 Python 依赖
echo "安装 Python 依赖..." >> "${TRIM_TEMP_LOGFILE}"
if [ -f requirements.txt ]; then
    pip install -r requirements.txt 2>> "${TRIM_TEMP_LOGFILE}"
    PIP_EXIT=$?
else
    echo "警告：未找到 requirements.txt，将安装基础依赖" >> "${TRIM_TEMP_LOGFILE}"
    pip install fastapi uvicorn 2>> "${TRIM_TEMP_LOGFILE}"
    PIP_EXIT=$?
fi

if [ ${PIP_EXIT} -ne 0 ]; then
    echo "错误：pip 安装依赖失败，请查看上方日志" >> "${TRIM_TEMP_LOGFILE}"
    deactivate
    exit 1
fi

# 5. 验证关键模块可导入
echo "验证关键模块..." >> "${TRIM_TEMP_LOGFILE}"
for mod in fastapi uvicorn; do
    python3 -c "import ${mod}" 2>&1
    if [ $? -ne 0 ]; then
        echo "错误：模块 ${mod} 导入失败" >> "${TRIM_TEMP_LOGFILE}"
        deactivate
        exit 1
    fi
    echo "  ✓ ${mod}" >> "${TRIM_TEMP_LOGFILE}"
done

deactivate

# 5.5 补装系统级 iSCSI 依赖（targetcli / LIO）
# --------------------------------------------------------
# iSCSI 桥接（ZVOL → target）需要 host 上有 targetcli。
# fnOS 官方 iSCSI 服务底层也用 LIO/targetcli，
# 所以本 app 不重复造 CHAP/Portal/ACL UI，只做 ZVOL 桥接。
# --------------------------------------------------------
echo "检查/安装 iSCSI 系统依赖..." >> "${TRIM_TEMP_LOGFILE}"
ISCSI_PKGS=(targetcli-fb)
PKG_MGR=""
if command -v apt-get &>/dev/null; then PKG_MGR="apt"; APT=1; else APT=0; fi
if command -v yum &>/dev/null; then PKG_MGR="yum"; YUM=1; else YUM=0; fi
if command -v dnf &>/dev/null; then PKG_MGR="dnf"; DNF=1; else DNF=0; fi
if command -v apk &>/dev/null; then PKG_MGR="apk"; APK=1; else APK=0; fi

install_pkg() {
    case "${PKG_MGR}" in
        apt)  apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends "$@" >> "${TRIM_TEMP_LOGFILE}" 2>&1 ;;
        yum)  yum install -y -q "$@" >> "${TRIM_TEMP_LOGFILE}" 2>&1 ;;
        dnf)  dnf install -y -q "$@" >> "${TRIM_TEMP_LOGFILE}" 2>&1 ;;
        apk)  apk add --no-cache "$@" >> "${TRIM_TEMP_LOGFILE}" 2>&1 ;;
        *)    echo "警告：未识别包管理器，跳过 iSCSI 依赖安装" >> "${TRIM_TEMP_LOGFILE}"; return 1 ;;
    esac
}

if command -v targetcli &>/dev/null; then
    echo "  ✓ targetcli 已安装: $(targetcli version 2>/dev/null | head -1)" >> "${TRIM_TEMP_LOGFILE}"
else
    if [ -n "${PKG_MGR}" ]; then
        echo "  → 正在安装 ${ISCSI_PKGS[*]} (via ${PKG_MGR})..." >> "${TRIM_TEMP_LOGFILE}"
        if install_pkg "${ISCSI_PKGS[@]}"; then
            echo "  ✓ ${ISCSI_PKGS[*]} 安装完成" >> "${TRIM_TEMP_LOGFILE}"
        else
            echo "  ✗ iSCSI 依赖安装失败，应用仍可装但 iSCSI 功能不可用" >> "${TRIM_TEMP_LOGFILE}"
        fi
    else
        echo "  ✗ 未检测到 apt/yum/dnf/apk，请手动安装 targetcli-fb" >> "${TRIM_TEMP_LOGFILE}"
    fi
fi

# 尝试加载 LIO 内核模块（targetcli 需要它）
if [ -f /proc/modules ] && ! grep -q '^target_core_mod' /proc/modules 2>/dev/null; then
    modprobe target_core_mod 2>> "${TRIM_TEMP_LOGFILE}" && \
        echo "  ✓ 已加载 target_core_mod 内核模块" >> "${TRIM_TEMP_LOGFILE}" || \
        echo "  ! 提示：target_core_mod 加载失败，iSCSI 功能将不可用" >> "${TRIM_TEMP_LOGFILE}"
fi

# 6. 同步应用中心入口的端口（避免图标跳转 8765 而实际换了端口）
APP_PORT="${WEB_PORT:-8765}"
UI_CFG="${APP_BASE}/app/ui/config"
if [ -f "${UI_CFG}" ]; then
    if sed -i.tmp "s/\"port\": *\"8765\"/\"port\": \"${APP_PORT}\"/" "${UI_CFG}" 2>/dev/null; then
        rm -f "${UI_CFG}.tmp"
        echo "应用中心入口端口已同步为 ${APP_PORT}" >> "${TRIM_TEMP_LOGFILE}"
    else
        mv -f "${UI_CFG}.tmp" "${UI_CFG}" 2>/dev/null || true
        echo "警告：同步 app/ui/config 端口失败，请手动检查" >> "${TRIM_TEMP_LOGFILE}"
    fi
fi

echo "=============================================" >> "${TRIM_TEMP_LOGFILE}"
echo "安装配置完成 ✓" >> "${TRIM_TEMP_LOGFILE}"

exit 0
