#!/bin/bash
# ============================================================
# ZVOL Manager — 安装前环境检测
# 在文件解压之前执行，阻断不合规环境的安装
# ============================================================

# ZFS 检测（可选，仅提示不阻断）
if ! command -v zfs &>/dev/null; then
    echo "=============================================
  ZVOL Manager 警告：未检测到 ZFS
---------------------------------------------
  本应用需要 ZFS 文件系统支持。
  请确认系统已配置 ZFS 存储池。
=============================================" > "${TRIM_TEMP_LOGFILE}"
    # 不阻断安装，仅提示
fi

exit 0
